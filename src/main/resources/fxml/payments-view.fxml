<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.photostudio.fx.controller.PaymentsController" styleClass="tab-content">
    <top>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="panel">
            <Label text="Способ оплаты:"/>
            <ComboBox fx:id="methodCombo" prefWidth="220"/>
            <Button text="Принять платёж…" styleClass="primary-button" onAction="#onAdd"/>
            <Button fx:id="deleteButton" text="Удалить" styleClass="danger-button" onAction="#onDelete"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Обновить" styleClass="secondary-button" onAction="#onRefresh"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="idColumn" text="№" prefWidth="50"/>
                <TableColumn fx:id="bookingColumn" text="Бронирование" prefWidth="380"/>
                <TableColumn fx:id="amountColumn" text="Сумма" prefWidth="120"/>
                <TableColumn fx:id="methodColumn" text="Способ оплаты" prefWidth="170"/>
                <TableColumn fx:id="dateColumn" text="Дата платежа" prefWidth="150"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox styleClass="panel">
            <Label fx:id="countLabel" styleClass="status-bar"/>
        </HBox>
    </bottom>
</BorderPane>

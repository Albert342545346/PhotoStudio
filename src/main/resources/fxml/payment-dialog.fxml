<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.photostudio.fx.controller.PaymentDialogController" spacing="14" prefWidth="560" styleClass="dialog-root">
    <Label text="Приём платежа" styleClass="dialog-title"/>
    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="130" halignment="RIGHT"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="280"/>
        </columnConstraints>
            <Label text="Бронирование *" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
            <ComboBox fx:id="bookingCombo" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Остаток к оплате" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
            <Label fx:id="remainingLabel" styleClass="value-label" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Сумма, ₽ *" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
            <TextField fx:id="amountField" promptText="1000" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Способ оплаты *" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
            <ComboBox fx:id="methodCombo" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>
    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button text="Оплатить остаток" styleClass="secondary-button" onAction="#onPayFull"/>
        <Button text="Сохранить" defaultButton="true" styleClass="primary-button" onAction="#onSave"/>
        <Button text="Отмена" cancelButton="true" styleClass="secondary-button" onAction="#onCancel"/>
    </HBox>
</VBox>

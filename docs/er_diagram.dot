digraph ER {
  graph [rankdir=LR, fontname="Helvetica", pad=0.4, nodesep=0.6, ranksep=1.4, bgcolor="white",
         label="ER-диаграмма БД «Фотостудия» (PostgreSQL)\n", labelloc=t, fontsize=20];
  node  [shape=plain, fontname="Helvetica", fontsize=12];
  edge  [fontname="Helvetica", fontsize=11, color="#37474F", penwidth=1.6];

  clients [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD COLSPAN="3" BGCOLOR="#1565C0"><FONT COLOR="white"><B>clients</B> (клиенты)</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">SERIAL</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">VARCHAR(100) NOT NULL</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">VARCHAR(20) NOT NULL</TD></TR>
      <TR><TD><B>UQ</B></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(100) NOT NULL</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">registered_at</TD><TD ALIGN="LEFT">TIMESTAMP NOT NULL</TD></TR>
    </TABLE>>];

  halls [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD COLSPAN="3" BGCOLOR="#2E7D32"><FONT COLOR="white"><B>halls</B> (залы)</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">SERIAL</TD></TR>
      <TR><TD><B>UQ</B></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(50) NOT NULL</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">capacity</TD><TD ALIGN="LEFT">INT NOT NULL, CHECK &gt; 0</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">price_per_hour</TD><TD ALIGN="LEFT">NUMERIC(10,2) NOT NULL, CHECK &gt; 0</TD></TR>
    </TABLE>>];

  bookings [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD COLSPAN="3" BGCOLOR="#E65100"><FONT COLOR="white"><B>bookings</B> (бронирования фотосессий)</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">SERIAL</TD></TR>
      <TR><TD PORT="client"><B>FK</B></TD><TD ALIGN="LEFT">client_id</TD><TD ALIGN="LEFT">INT NOT NULL → clients.id</TD></TR>
      <TR><TD PORT="hall"><B>FK</B></TD><TD ALIGN="LEFT">hall_id</TD><TD ALIGN="LEFT">INT NOT NULL → halls.id</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">VARCHAR(100) NOT NULL</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">session_type</TD><TD ALIGN="LEFT">VARCHAR(20) NOT NULL, CHECK IN (6 типов)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">start_time</TD><TD ALIGN="LEFT">TIMESTAMP NOT NULL</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">duration_hours</TD><TD ALIGN="LEFT">INT NOT NULL, CHECK 1..8</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT">NUMERIC(10,2) NOT NULL, CHECK &gt;= 0</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(20) NOT NULL, CHECK IN (4 статуса)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP NOT NULL</TD></TR>
    </TABLE>>];

  clients:e -> bookings:client:w [label=" 1 : N
 «делает заказ»", dir=both, arrowtail=tee, arrowhead=crow];
  halls:e   -> bookings:hall:w   [label=" 1 : N
 «проходит в зале»", dir=both, arrowtail=tee, arrowhead=crow];
}
